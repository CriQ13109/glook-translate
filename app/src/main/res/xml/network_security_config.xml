<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 평문 HTTP 금지, 사용자 추가 CA 불신(시스템 CA만 신뢰) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
